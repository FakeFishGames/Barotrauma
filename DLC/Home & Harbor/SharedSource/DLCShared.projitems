<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>7c1c5d04-3108-447b-8ce6-9f5effa614ec</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>SharedSource</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup Label="RiderPleaseDoNotTouchThis">
    <Compile Include="$(MSBuildThisFileDirectory)**\*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)changelog.txt" />
    <Content Include="$(MSBuildThisFileDirectory)Content\**\*.*" />
    <Content Include="$(MSBuildThisFileDirectory)filelist.xml" />
  </ItemGroup>
  <PropertyGroup>
    <DepBuildConfiguration Condition="'$(Configuration)'!='Debug'">Release</DepBuildConfiguration>
    <DepBuildConfiguration Condition="'$(Configuration)'=='Debug'">Debug</DepBuildConfiguration>
  </PropertyGroup>
</Project>